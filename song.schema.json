{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songbird.example/song.schema.json",
  "title": "Songbird song v1 / v2",
  "description": "Timed piano notes with runtime fingering. Version 1 uses event-length notes; version 2 supports independent durations and MIDI velocities. Up to 4096 events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "category",
    "tempo",
    "timeSignature",
    "events"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "composer": {
      "type": "string",
      "maxLength": 120
    },
    "category": {
      "enum": [
        "melody",
        "chords"
      ]
    },
    "tempo": {
      "type": "integer",
      "minimum": 35,
      "maximum": 140
    },
    "timeSignature": {
      "enum": [
        "4/4",
        "3/4",
        "2/4",
        "3/8"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096
    },
    "pickup": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 4,
      "description": "Pickup length in quarter-note beats; must be shorter than one measure."
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitch"
      ],
      "properties": {
        "pitch": {
          "type": "string",
          "pattern": "^([A-G][#b]?[0-7]|C8)$",
          "description": "Piano pitch A0-C8, including sharps/flats. Runtime checks enforce the physical piano range."
        }
      }
    },
    "hand": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "notes"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/note"
          },
          "description": "Up to five simultaneous piano notes within an octave. Finger placement is generated."
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats"
      ],
      "properties": {
        "beats": {
          "enum": [
            0.25,
            0.5,
            0.75,
            1,
            1.5,
            2,
            3,
            4,
            6
          ],
          "description": "Duration in quarter-note beats."
        },
        "left": {
          "$ref": "#/$defs/hand"
        },
        "right": {
          "$ref": "#/$defs/hand"
        }
      }
    },
    "noteV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitch",
        "duration"
      ],
      "properties": {
        "pitch": {
          "type": "string",
          "pattern": "^([A-G][#b]?[0-7]|C8)$",
          "description": "Piano pitch A0-C8, including sharps/flats. Runtime checks enforce the physical piano range."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "description": "Independent note length in quarter-note beats, including tuplets."
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      }
    },
    "handV2": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "notes"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/noteV2"
          },
          "description": "Up to five simultaneous piano notes within an octave. Finger placement is generated."
        }
      }
    },
    "eventV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats"
      ],
      "properties": {
        "beats": {
          "type": "number",
          "minimum": 0.0006510416666666666,
          "maximum": 16
        },
        "left": {
          "$ref": "#/$defs/handV2"
        },
        "right": {
          "$ref": "#/$defs/handV2"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/$defs/event"
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/$defs/eventV2"
            }
          }
        }
      }
    }
  ]
}
