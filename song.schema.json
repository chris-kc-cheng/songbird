{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songbird.example/song.schema.json",
  "title": "Songbird song v1",
  "description": "C-major beginner lessons. Events are sequential, hands and notes within each event sound simultaneously. Omitted/null hands rest. A beat is a quarter note. Semantic checks additionally enforce unique fingers, matching five-finger placements, and non-overlapping hands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "category",
    "tempo",
    "timeSignature",
    "events"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "composer": {
      "type": "string",
      "maxLength": 120
    },
    "category": {
      "enum": [
        "melody",
        "chords"
      ]
    },
    "tempo": {
      "type": "integer",
      "minimum": 35,
      "maximum": 140
    },
    "timeSignature": {
      "enum": [
        "4/4",
        "3/4",
        "2/4"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitch",
        "finger"
      ],
      "properties": {
        "pitch": {
          "type": "string",
          "pattern": "^[A-G][3-5]$",
          "description": "Natural piano pitch, C3\u2013B5. C4 is middle C."
        },
        "finger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1 thumb, 2 index, 3 middle, 4 ring, 5 little. Must match the declared five-finger position."
        }
      }
    },
    "hand": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "position",
        "notes"
      ],
      "properties": {
        "position": {
          "type": "string",
          "pattern": "^([A-G][34]|[CDE]5)$",
          "description": "Lowest of five consecutive white keys. Right hand: fingers 1\u20135 ascending; left hand: 5\u20131 ascending."
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/note"
          },
          "description": "Notes played simultaneously by this hand."
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats"
      ],
      "properties": {
        "beats": {
          "enum": [
            0.25,
            0.5,
            0.75,
            1,
            1.5,
            2,
            3,
            4,
            6
          ],
          "description": "Duration in quarter-note beats."
        },
        "left": {
          "$ref": "#/$defs/hand"
        },
        "right": {
          "$ref": "#/$defs/hand"
        }
      }
    }
  }
}
